#version 450

layout(local_size_x = 256) in;

layout(push_constant) uniform PushConstants {
  uint numPrimitives;
} pc;

struct AABB {
  vec4 min;
  vec4 max;
};
struct InternalNode {
  int left;
  int right;
  uint leftIsLeaf;
  uint rightIsLeaf;
  int parent;
  uint visited;
};

struct LeafNode {
  int parent;
};

layout(std430, binding = 0) readonly buffer PrimitiveAABBs {
  AABB primitiveAABBs[];
};
layout(std430, binding = 1) readonly buffer SortedPrimitiveIndices {
  uint primitiveIndices[];
};
layout(std430, binding = 2) buffer InternalNodes {
  InternalNode internalNodes[];
};
layout(std430, binding = 3) readonly buffer LeafNodes {
  LeafNode leafNodes[];
};
layout(std430, binding = 4) buffer NodeAABBs {
  AABB nodeAABBs[];
};

AABB mergeAABB(AABB a, AABB b) {
  AABB r;
  r.min = min(a.min, b.min);
  r.max = max(a.max, b.max);
  return r;
}

void main() {
  uint leafIdx = gl_GlobalInvocationID.x;
  if (leafIdx >= pc.numPrimitives) return;

  int parentNode = leafNodes[leafIdx].parent;

  while (parentNode != -1 && atomicAdd(internalNodes[parentNode].visited, 1) > 0) {
    int left = internalNodes[parentNode].left;
    int right = internalNodes[parentNode].right;
    AABB leftBbox;
    AABB rightBbox;

    if (internalNodes[parentNode].leftIsLeaf == 1) {
      leftBbox = primitiveAABBs[primitiveIndices[left]];
    } else {
      leftBbox = nodeAABBs[left];
    }

    if (internalNodes[parentNode].rightIsLeaf == 1) {
      rightBbox = primitiveAABBs[primitiveIndices[right]];
    } else {
      rightBbox = nodeAABBs[right];
    }

    AABB nodeBbox = mergeAABB(leftBbox, rightBbox);
    nodeAABBs[parentNode] = nodeBbox;

    parentNode = internalNodes[parentNode].parent;
  }
}

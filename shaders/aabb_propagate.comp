#version 450

// bindings: 0 = primitive AABBs (in), 1 = sorted primitive indices (in),
//           2 = internal nodes (inout, .visited used as the atomic flag),
//           3 = leaf nodes (in), 4 = internal node AABBs (out)
// one thread per leaf, walking upward via parent pointers.

layout(local_size_x = 256) in;

layout(push_constant) uniform PushConstants {
  uint numPrimitives;
} pc;

struct AABB {
  vec3 min;
  float pad0;
  vec3 max;
  float pad1;
};
struct InternalNode {
  int left;
  int right;
  uint leftIsLeaf;
  uint rightIsLeaf;
  int parent;
  uint visited;
};

struct LeafNode {
  int parent;
};

layout(std430, binding = 0) readonly buffer PrimitiveAABBs {
  AABB primitiveAABBs[];
};
layout(std430, binding = 1) readonly buffer SortedPrimitiveIndices {
  uint primitiveIndices[];
};
layout(std430, binding = 2) buffer InternalNodes {
  InternalNode internalNodes[];
};
layout(std430, binding = 3) readonly buffer LeafNodes {
  LeafNode leafNodes[];
};
layout(std430, binding = 4) buffer NodeAABBs {
  AABB nodeAABBs[];
};

AABB mergeAABB(AABB a, AABB b) {
  AABB r;
  r.mn = min(a.mn, b.mn);
  r.mx = max(a.mx, b.mx);
  return r;
}

void main() {
  uint leafIdx = gl_GlobalInvocationID.x;
  if (leafIdx >= pc.numPrimitives) return;

  int node = leafNodes[leafIdx].parent;
  if (node == -1) return;

  while (atomicAdd(internalNodes[node], 1) == 1) {
    AABB nodeBbox = mergeAABB(node.left, node.right);

    nodeAABBs[primitiveIndices[node]] = nodeBbox;

    node = node.parent;
  }
  // TODO: implement the bottom-up walk from Section 4 (BVHs) —
  //   1. start from leafNodes[leafIdx]'s AABB (via primitiveAABBs[primitiveIndices[leafIdx]])
  //   2. climb to .parent, using atomicAdd (or atomicExchange/atomicCompSwap)
  //      on internalNodes[node].visited so only the *second* thread to
  //      arrive at a node continues past it — the first terminates.
  //   3. the continuing thread merges its child AABBs with mergeAABB()
  //      and writes nodeAABBs[node], then moves to node's parent.
  //   4. stop once you've processed the root (parent == -1).
}
